[Unit]
Description=Crypto Radar analysis dashboard
After=network-online.target
Wants=network-online.target
[Service]
User=cryptojev
WorkingDirectory=/opt/crypto-jev
EnvironmentFile=/opt/crypto-jev/.env
ExecStart=/opt/crypto-jev/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8082 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-jev/data
[Install]
WantedBy=multi-user.target
