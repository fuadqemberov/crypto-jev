TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
SYMBOLS=ALL
SCAN_SECONDS=300
MIN_AI_CONFIDENCE=0.90
MAX_SPREAD_BPS=15
MAX_FUNDING_RATE=0.0003
DATA_DIR=data
# Set BOTH before exposing through an authenticated HTTPS reverse proxy.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Explicit offline demonstration; never substitutes for live data automatically.
DEMO_MODE=false
# Run python -m app.paper to generate matching local connection credentials.
BRIDGE_TOKEN=
SIGNAL_TTL_SECONDS=
FREQTRADE_URL=http://127.0.0.1:8083
FREQTRADE_USER=
FREQTRADE_PASSWORD=

# Adaptive scan: conservative / balanced / aggressive (scan aggressiveness only).
PERFORMANCE_PROFILE=balanced
# Optional overrides; blank uses the profile default.
PRIORITY_SCAN_SECONDS=
RADAR_PARALLELISM=
PRIORITY_PARALLELISM=
PRIORITY_SIZE=24
RECENT_CONFIDENCE_SECONDS=900
SYMBOL_TIMEOUT_SECONDS=35
AI_CACHE_SIZE=3000
AI_CACHE_TTL_SECONDS=300
AI_CACHE_PERSISTENT=false
MIN_CLOSE_CONFIDENCE=0.85
BRIDGE_POLL_SECONDS=1
# Run python -m app.paper --upgrade after changing any shared risk settings.
CAPITAL_RISK=0.005
MAX_MARGIN_FRACTION=0.07
MAX_MARGIN_LOSS=0.50
MAX_LEVERAGE=20
DAILY_LOSS_FRACTION=0.03
MIN_NET_RR=1.5
MAX_ENTRY_SLIPPAGE=0.003
COST_PER_SIDE=0.0008
FUNDING_RESERVE_PERIODS=1
COOLDOWN_SECONDS=300

# Global JEV pacing across radar, priority and retries; match your provider plan.
JEV_REQUESTS_PER_SECOND=2
