# SCALPING (scalping-5m branch): 30 sürətli strategiya, hər biri ayrıca virtual USDT-M futures hesabı ilə.
# Hər mövqe ən gec MAX_HOLD_MINUTES dəqiqədə bağlanır. Yalnız paper, real order yoxdur.

# ALL = 24 saatlıq həcmə görə ən böyük TOP_N USDT perpetual; və ya siyahı: BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=ALL
# Scalping üçün ən likvid 30 coin (az sürüşmə)
TOP_N=30
# Şam intervalı: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h — scalping üçün 1m
TIMEFRAME=1m
# Mövqe ən gec bu qədər dəqiqədə bağlanır (stop / TP / siqnal daha tez bağlaya bilər)
MAX_HOLD_MINUTES=5
# Hər neçə saniyədən bir qiymət, stop, TP və 5 dəqiqə yoxlanır
PRICE_REFRESH_SECONDS=5
# Bot başlayandan sonra bu qədər saniyə yeni order açılmır
STARTUP_DELAY_SECONDS=60
HISTORY_BARS=300

# Hər strategiyanın başlanğıc balansı (USDT)
START_CAPITAL=2000
# Hər yeni mövqenin marjası = cari balansın bu faizi. Paralel mövqe sayına limit yoxdur,
# yalnız sərbəst marja çatmalıdır.
ORDER_MARGIN_PCT=5
MIN_MARGIN_USDT=5
# Mövqenin xalis mənfəəti (komissiya + funding çıxılmaqla) bu məbləğə çatanda bağlanır; 0 = söndür
# Take-profit = stop məsafəsinin bu qatı (R). 1.5 → TP-də qazanc ≈ 1.5 × stopdakı zərər (0 = söndür)
TP_R_MULTIPLE=1.5
# Əlavə sabit TP (USDT, xalis). 0 = söndür. Qeyd: 15 qoysanız R-TP-dən əvvəl işləyər və R/R yenə pozular
TAKE_PROFIT_USDT=0
# Leverage = floor(RISK_PER_MOVE / (ATR% × strategiyanın ATR əmsalı)); 0.25 → stopda ~25% marja zərər
RISK_PER_MOVE=0.25
# Komissiya filtri: gediş-dönüş komissiya+sürüşmə stop məsafəsinin bu payından çoxdursa giriş edilmir (0 = söndür).
# Scalping-də stop çox yaxındır: 0.35 → komissiya riskin ≤35%-i. Daha aşağı qoysanız demək olar ki, heç bir order açılmaz
MAX_COST_R=0.35
# --- Eksperimental (default söndürülüb; demo testində ümumi nəticəni pisləşdirdi) ---
# Siqnal çıxışı: all = hər strategiya əks siqnalda bağlanır (default); auto = trend strategiyaları yalnız stop/TP ilə
SIGNAL_EXITS=all
# Bağlanışdan sonra eyni coin-ə bu qədər şam girmə (0 = söndür)
COOLDOWN_BARS=0
# Stop-loss: giriş − strategiyanın ATR əmsalı × ATR(14), amma zərər marjanın bu faizindən çox olmur (0 = söndür)
STOP_LOSS_PCT=50
# Leverage-i hər strategiya özü seçir (ATR ilə), 1×-dən bu həddə qədər (1–125). Scalping: 20
MAX_LEVERAGE=20
# Taker komissiyası, sürüşmə və likvidasiya üçün maintenance margin (hər tərəfə; 0.0005 = 0.05%)
FEE_RATE=0.0005
# Ən likvid 30 coin-də kiçik order üçün sürüşmə ~0.02% (1h versiyada 0.05% idi)
SLIPPAGE_RATE=0.0002
MAINT_MARGIN_RATE=0.005

PRICE_REFRESH_SECONDS=15
CANDLE_DELAY_SECONDS=5
HISTORY_BARS=500
KLINE_PARALLELISM=6
# Binance USDT-M futures açıq API (ABŞ kimi bəzi regionlarda 451 qaytarır)
BINANCE_URL=https://fapi.binance.com/fapi/v1

DATA_DIR=data
# Serveri internetə açırsınızsa HƏR İKİSİNİ verin (HTTPS reverse proxy arxasında).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Şəbəkəsiz sintetik bazar (hər DEMO_CANDLE_SECONDS saniyədə 1 şam). data/demo-futures.db işlədir.
DEMO_MODE=false
DEMO_CANDLE_SECONDS=20
