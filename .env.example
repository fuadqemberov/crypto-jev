# 20 strategiya — hər biri ayrıca virtual USDT hesabı ilə (yalnız paper, real order yoxdur).

# ALL = 24 saatlıq həcmə görə ən böyük TOP_N USDT spot cütü; və ya siyahı: BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=ALL
TOP_N=50
# Şam intervalı: 15m, 30m, 1h, 2h, 4h (backtest 1h ilə aparılıb)
TIMEFRAME=1h

# Hər strategiyanın başlanğıc balansı (USDT) və eyni anda maksimum açıq mövqe sayı.
# Mövqe ölçüsü = hesab balansı / MAX_POSITIONS (nağd qədər).
START_CAPITAL=2000
MAX_POSITIONS=10
MIN_ORDER_USDT=10
# Hər tərəfə komissiya və sürüşmə (0.001 = 0.10%)
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005

# Qiymət yeniləmə (saniyə) və şam bağlandıqdan sonra gözləmə
PRICE_REFRESH_SECONDS=15
CANDLE_DELAY_SECONDS=5
HISTORY_BARS=500
KLINE_PARALLELISM=6
BINANCE_URL=https://data-api.binance.vision/api/v3

DATA_DIR=data
# Serveri internetə açırsınızsa HƏR İKİSİNİ verin (HTTPS reverse proxy arxasında).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Şəbəkəsiz sintetik bazar (sürətləndirilmiş saat: hər DEMO_CANDLE_SECONDS saniyədə 1 şam).
# Ayrıca data/demo.db işlədir, canlı hesablara toxunmur.
DEMO_MODE=false
DEMO_CANDLE_SECONDS=20
