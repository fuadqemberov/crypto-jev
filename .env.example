SYMBOLS=ALL
SCAN_SECONDS=300
MAX_SPREAD_BPS=15
MAX_FUNDING_RATE=0.0003
DATA_DIR=data
# Set BOTH before exposing through an authenticated HTTPS reverse proxy.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Explicit offline demonstration; never substitutes for live data automatically.
DEMO_MODE=false
# Run python -m app.paper to generate matching local connection credentials.
BRIDGE_TOKEN=
SIGNAL_TTL_SECONDS=
FREQTRADE_URL=http://127.0.0.1:8083
FREQTRADE_USER=
FREQTRADE_PASSWORD=

# Adaptive scan: conservative / balanced / aggressive (scan aggressiveness only).
PERFORMANCE_PROFILE=balanced
# Optional overrides; blank uses the profile default.
PRIORITY_SCAN_SECONDS=
RADAR_PARALLELISM=
PRIORITY_PARALLELISM=
PRIORITY_SIZE=24
RECENT_SIGNAL_SECONDS=900
SYMBOL_TIMEOUT_SECONDS=35
BRIDGE_POLL_SECONDS=1
# Run python -m app.paper --upgrade after changing any shared risk settings.
CAPITAL_RISK=0.005
MAX_MARGIN_FRACTION=0.07
MAX_MARGIN_LOSS=0.50
MAX_LEVERAGE=20
DAILY_LOSS_FRACTION=0.03
MIN_NET_RR=1.5
MAX_ENTRY_SLIPPAGE=0.003
COST_PER_SIDE=0.0008
FUNDING_RESERVE_PERIODS=1
COOLDOWN_SECONDS=300

# Local deterministic rules (no probabilities or external model).
RULE_MIN_RELATIVE_VOLUME=1.0
RULE_MAX_EXTENSION_ATR=1.0
RULE_MAX_PRICE_GAP_ATR=0.5
RULE_MIN_ATR_PCT=0.1
RULE_MAX_ATR_PCT=5.0
RULE_RSI_LONG_MAX=68
RULE_STOP_ATR=2.0
RULE_TARGET_R=2.0

# RSI heatmap radar (SYMBOLS=ALL): only the selected markets get a full analysis.
# auto = CoinGlass when COINGLASS_API_KEY is set (Standard plan+), otherwise computed from Binance 1h candles.
HEATMAP_SOURCE=auto
COINGLASS_API_KEY=
HEATMAP_SIZE=40
# LONG candidates need RSI 1h and 4h >= this, SHORT <= 100 - this.
HEATMAP_TREND_RSI=55
